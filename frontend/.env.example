# Copy to .env.local for a run on your own machine. Never put a secret here: the web app needs none.
# Where the Next.js SERVER reaches the API. The browser never calls the API directly.
API_INTERNAL_URL=http://localhost:8000
# The one address you open the site at. Changes are accepted only from it (127.0.0.1 is not
# localhost), and https turns on Secure cookies. Plain http is allowed only on this machine.
APP_ORIGIN=http://127.0.0.1:3000
# Next.js sends anonymous usage data unless this is set.
NEXT_TELEMETRY_DISABLED=1
